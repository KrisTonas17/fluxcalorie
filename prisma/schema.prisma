generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Food {
  id           String   @id @default(cuid())
  name         String
  brandName    String?
  source       String   // "usda", "off", "menustat", "custom"
  sourceId     String?  // original ID from source
  servingAmount Float?
  servingUnit  String?
  gramWeight   Float?
  calories     Float
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  fiberG       Float?
  sugarG       Float?
  sodiumMg     Float?
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([brandName])
  @@index([source])
  @@index([sourceId])
}
